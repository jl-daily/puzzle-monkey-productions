# Copy to .env and fill in. Never commit .env.
# TMDB (required for search/details/providers): https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# Google Sheet gateway + token (syncs lists/scores; leave blank to run app-only)
SHEET_URL=
SHEET_TOKEN=
# Taste.io refresh token (auto-fetches match scores on the 2026 tab)
TASTE_REFRESH_TOKEN=
# Fixed public URL (e.g. Railway domain). Registers itself with the sheet
# gateway so the Apps Script always knows where the app lives.
STABLE_URL=
# SQLite location. Defaults to ~/.movie-app.db locally;
# hosting sets this to the persistent volume (see Dockerfile).
MOVIE_DB_PATH=
